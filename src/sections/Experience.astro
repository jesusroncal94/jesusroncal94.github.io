---
import SectionHead from '../components/SectionHead.astro';
import profile from '../../data/public-profile.json';
import type { Locale } from '../i18n/locales';
import { buildTimeline } from '../lib/timeline';
import { getSite } from '../lib/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { experience } = await getSite(locale);
const { rows, earlierPeriod } = buildTimeline(profile.roles, experience.entries, locale);
const rowClass = 'flex flex-col gap-1 border-t border-border py-4 md:grid md:grid-cols-[150px_360px_1fr_130px] md:items-center md:gap-8 md:py-5.5';
---

<section id="experience" aria-labelledby="experience-title" class="scroll-mt-4 border-t border-border px-6 py-14 md:px-20 md:py-30">
  <SectionHead
    headingId="experience-title"
    eyebrow={experience.eyebrow}
    title={experience.title}
    titleShort={experience.titleShort}
    lede={experience.lede}
  />

  <ol class="mt-8 md:mt-12">
    {rows.map(({ period, current, role, organisation, place, line, earlier }) => (
      <li class:list={[rowClass, earlier && 'max-md:hidden']}>
        <span class:list={['code-mono', current ? 'text-signal' : 'text-subtle']}>{period}</span>
        <span class="flex flex-col gap-0.5">
          <span class="body-m text-primary">{role}</span>
          <span class="body-s text-muted">{organisation}</span>
        </span>
        <span class="body-s text-muted max-md:hidden">{line}</span>
        <span class="code-mono text-right text-subtle max-md:hidden">{place}</span>
      </li>
    ))}
    <li class:list={[rowClass, 'md:hidden']}>
      <span class="code-mono text-subtle">{earlierPeriod}</span>
      <span class="body-m text-primary">{experience.earlierSummary.role}</span>
      <span class="body-s text-muted">{experience.earlierSummary.organisation}</span>
    </li>
  </ol>
</section>
