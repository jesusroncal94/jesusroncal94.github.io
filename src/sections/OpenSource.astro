---
import Icon from '../components/Icon.astro';
import SectionHead from '../components/SectionHead.astro';
import StackTag from '../components/StackTag.astro';
import type { Locale } from '../i18n/locales';
import { useTranslations } from '../i18n/translate';
import { getSite } from '../lib/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const { openSource } = await getSite(locale);
---

<section id="open-source" aria-labelledby="open-source-title" class="scroll-mt-4 border-t border-border px-page py-14 md:py-30">
  <SectionHead headingId="open-source-title" eyebrow={openSource.eyebrow} title={openSource.title} lede={openSource.lede} />

  <ul class="mt-8 grid gap-5 md:mt-12 md:gap-6 xl:grid-cols-3">
    {openSource.repos.map(({ name, url, title, pitch, note, stack }) => (
      <li>
        <a
          href={url}
          target="_blank"
          rel="noopener"
          class="flex h-full flex-col gap-4 rounded-lg border border-border bg-surface p-7 transition-colors hover:border-border-strong"
        >
          <span class="flex items-center justify-between gap-4">
            <span class="code-mono min-w-0 text-glow wrap-anywhere">{name}</span>
            <Icon name="arrow-up-right" size={16} class="text-subtle" />
          </span>
          <span class="heading-h3 text-primary">{title}</span>
          <span class="body-s flex-1 text-muted">{pitch}</span>
          <span class="code-mono rounded-sm bg-raised px-3 py-2 text-muted">{note}</span>
          <ul class="flex flex-wrap gap-2" aria-label={t('case.stack')}>
            {stack.map((label) => <StackTag label={label} />)}
          </ul>
        </a>
      </li>
    ))}
  </ul>
</section>
