---
import MetricTile from '../components/MetricTile.astro';
import type { Locale } from '../i18n/locales';
import { useTranslations } from '../i18n/translate';
import { getSite } from '../lib/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const { metrics } = await getSite(locale);
const compactMetrics = metrics.flatMap(({ compact, accent }) => (compact ? [{ ...compact, accent }] : []));
---

<section aria-label={t('section.proof')} class="px-6 pb-12 motion-safe:animate-rise md:px-20 md:pb-30">
  <ul class="grid grid-cols-4 gap-5 max-md:hidden">
    {metrics.map(({ value, caption, source }) => (
      <li>
        <MetricTile value={value} caption={caption} source={source} />
      </li>
    ))}
  </ul>

  <ul class="md:hidden">
    {compactMetrics.map(({ value, caption, accent }) => (
      <li class="flex items-center gap-3.5 border-t border-border py-3">
        <span class:list={['metric-s w-38 shrink-0 whitespace-nowrap', accent ? 'text-signal' : 'text-primary']}>{value}</span>
        <span class="body-s text-muted">{caption}</span>
      </li>
    ))}
  </ul>
</section>
