---
import EmailAction from '../components/EmailAction.astro';
import Icon from '../components/Icon.astro';
import { localePath, type Locale } from '../i18n/locales';
import { useTranslations } from '../i18n/translate';
import { getSite } from '../lib/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const site = await getSite(locale);

const links = [
  { href: '#work', label: t('nav.work') },
  { href: '#open-source', label: t('nav.openSource') },
  { href: '#experience', label: t('nav.experience') },
];
---

<header class="relative z-20 flex items-center justify-between px-6 py-4 md:px-20 md:py-5">
  <a href={localePath(locale)} class="flex items-center gap-2.5 rounded-sm">
    <span class="button-m grid size-8 place-items-center rounded-[9px] bg-signal text-on-signal" aria-hidden="true">
      {site.monogram}
    </span>
    <span class="button-m text-primary max-md:sr-only">{site.displayName}</span>
  </a>

  <nav aria-label={t('nav.menu')} class="max-md:hidden">
    <ul class="flex gap-9">
      {links.map(({ href, label }) => (
        <li>
          <a href={href} class="body-s text-muted transition-colors hover:text-primary">{label}</a>
        </li>
      ))}
    </ul>
  </nav>

  <EmailAction locale={locale} class="max-md:hidden" />

  <details class="group md:hidden" data-mobile-menu>
    <summary class="cursor-pointer list-none rounded-sm p-1 text-primary [&::-webkit-details-marker]:hidden">
      <span class="sr-only">{t('nav.menu')}</span>
      <Icon name="menu" size={24} class="group-open:hidden" />
      <Icon name="close" size={24} class="hidden group-open:block" />
    </summary>
    <nav aria-label={t('nav.menu')} class="absolute inset-x-4 top-16 rounded-lg border border-border-strong bg-surface p-2 shadow-float">
      <ul>
        {links.map(({ href, label }) => (
          <li>
            <a href={href} class="body-m block rounded-sm px-4 py-3 text-primary hover:bg-raised">{label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </details>
</header>

<script>
  const menu = document.querySelector<HTMLDetailsElement>('[data-mobile-menu]');
  menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => (menu.open = false)));
</script>
