---
import CaseCard from '../components/CaseCard.astro';
import Icon from '../components/Icon.astro';
import SectionHead from '../components/SectionHead.astro';
import type { Locale } from '../i18n/locales';
import { getCases } from '../lib/cases';
import { getSite } from '../lib/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { work } = await getSite(locale);
const cases = await getCases(locale);
const [first, second, ...more] = cases;
---

<section id="work" aria-labelledby="work-title" class="scroll-mt-4 px-page py-14 max-md:border-t max-md:border-border md:py-30">
  <SectionHead headingId="work-title" eyebrow={work.eyebrow} title={work.title} lede={work.lede} />

  <div class="mt-8 grid gap-5 md:mt-12 md:gap-6 xl:grid-cols-2">
    <CaseCard entry={first} locale={locale} />
    <CaseCard entry={second} locale={locale} />
    <div id="work-more" class="flex flex-col gap-5 max-md:hidden max-md:target:flex md:contents">
      {more.map((entry) => <CaseCard entry={entry} locale={locale} />)}
    </div>
  </div>

  <a href="#work-more" class="button-m mt-5 inline-flex items-center gap-2.5 px-2 py-3 text-muted hover:text-primary md:hidden">
    <Icon name="arrow-right" size={16} />
    {work.more}
  </a>
</section>
