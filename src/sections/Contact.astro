---
import Button from '../components/Button.astro';
import EmailAction from '../components/EmailAction.astro';
import profile from '../../data/public-profile.json';
import { localePath, type Locale } from '../i18n/locales';
import { useTranslations } from '../i18n/translate';
import { cvPath } from '../lib/cv';
import { getSite } from '../lib/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const site = await getSite(locale);
const { contact } = site;
const { email, linkedin, github } = profile.contact;
---

<section
  id="contact"
  aria-labelledby="contact-title"
  data-contact-zone
  class="scroll-mt-4 border-t border-border bg-linear-to-b from-canvas to-dusk px-page pt-18 pb-12 md:pt-35 md:pb-20"
>
  <div class="flex flex-col gap-6 md:items-center md:gap-8 md:text-center">
    <h2 id="contact-title" class="display text-primary">
      {contact.headlineLead}<br class="max-md:hidden" />
      {' '}<span class="display-serif text-signal">{contact.headlineAccent}</span>
    </h2>
    <p class="body-m text-muted md:hidden">{contact.ledeShort}</p>
    <p class="body-l max-w-155 text-muted max-md:hidden">{contact.lede}</p>
    <div class="flex flex-wrap gap-3">
      <Button icon="download" href={cvPath(locale)} download data-track="cv_download">{t('cta.downloadCv')}</Button>
      <EmailAction locale={locale} label={email} />
    </div>
  </div>

  <footer class="mt-18 flex flex-col gap-4 md:mt-30 md:flex-row md:items-center md:justify-between">
    <ul class="flex gap-6 md:order-2 md:gap-7">
      <li><a href={linkedin} target="_blank" rel="noopener" data-track="profile_open" data-track-target="linkedin" class="body-s text-primary hover:text-signal md:text-muted">LinkedIn ↗</a></li>
      <li><a href={github} target="_blank" rel="noopener" data-track="profile_open" data-track-target="github" class="body-s text-primary hover:text-signal md:text-muted">GitHub ↗</a></li>
      <li><a href={`mailto:${email}`} data-track="email_open" class="body-s text-primary hover:text-signal md:text-muted">{t('contact.email')}</a></li>
    </ul>
    <p class="code-mono text-subtle md:order-1">
      © 2026 {site.displayName} ·{' '}
      <a href={localePath(locale, 'privacy')} class="text-muted hover:text-primary">{t('footer.privacy')}</a>
    </p>
    <a href={contact.sourceUrl} target="_blank" rel="noopener" class="code-mono text-subtle hover:text-primary md:order-3">
      {t('footer.builtWith')} · {t('footer.source')} ↗
    </a>
  </footer>
</section>
