---
import CommandPalette from '../components/CommandPalette.astro';
import ContactBar from '../components/ContactBar.astro';
import Base from '../layouts/Base.astro';
import Contact from '../sections/Contact.astro';
import Experience from '../sections/Experience.astro';
import Hero from '../sections/Hero.astro';
import Nav from '../sections/Nav.astro';
import OpenSource from '../sections/OpenSource.astro';
import Principles from '../sections/Principles.astro';
import Proof from '../sections/Proof.astro';
import Work from '../sections/Work.astro';
import { DEFAULT_LOCALE } from '../i18n/locales';
import { ogImagePath } from '../lib/preview';
import { useTranslations } from '../i18n/translate';

const locale = DEFAULT_LOCALE;
const t = useTranslations(locale);
---

<Base locale={locale} title={t('site.title')} description={t('site.description')} image={{ path: ogImagePath(), alt: t('og.homeAlt') }}>
  <Nav locale={locale} />
  <main>
    <Hero locale={locale}>
      <CommandPalette slot="prompt" locale={locale} />
    </Hero>
    <Proof locale={locale} />
    <Work locale={locale} />
    <OpenSource locale={locale} />
    <Experience locale={locale} />
    <Principles locale={locale} />
    <Contact locale={locale} />
  </main>
  <ContactBar locale={locale} />
</Base>
