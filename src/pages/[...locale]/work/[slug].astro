---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import BeforeAfter from '../../../components/BeforeAfter.astro';
import Button from '../../../components/Button.astro';
import CaseMechanism from '../../../components/CaseMechanism.astro';
import ContactBar from '../../../components/ContactBar.astro';
import EmailAction from '../../../components/EmailAction.astro';
import Icon from '../../../components/Icon.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import StackTag from '../../../components/StackTag.astro';
import Base from '../../../layouts/Base.astro';
import Nav from '../../../sections/Nav.astro';
import profile from '../../../../data/public-profile.json';
import { formatPeriod } from '../../../i18n/format';
import { localePath, localeRoutes, type Locale } from '../../../i18n/locales';
import { interpolate, useTranslations } from '../../../i18n/translate';
import { caseEyebrow, caseSlug, getCases, type Case } from '../../../lib/cases';
import { cvPath } from '../../../lib/cv';
import { ogImagePath } from '../../../lib/preview';
import { getSite } from '../../../lib/site';
import { caseArticle } from '../../../lib/structured-data';

export const getStaticPaths = (async () => {
  const routes = await Promise.all(
    localeRoutes().map(async ({ params, props: { locale } }) => {
      const cases = await getCases(locale);
      return cases.map((entry, index) => ({
        params: { ...params, slug: caseSlug(entry) },
        props: { locale, entry, next: cases[(index + 1) % cases.length] },
      }));
    }),
  );
  return routes.flat();
}) satisfies GetStaticPaths;

interface Props {
  locale: Locale;
  entry: Case;
  next: Case;
}

const { locale, entry, next } = Astro.props;
const t = useTranslations(locale);
const { title, summary, before, after, stack, roleId } = entry.data;
const role = profile.roles.find(({ id }) => id === roleId);
if (!role) throw new Error(`Case ${entry.id} references an unknown role: ${roleId}`);
const { Content } = await render(entry);
const site = String(Astro.site);
const preview = ogImagePath(locale, caseSlug(entry));
const structuredData = caseArticle({
  site,
  author: { name: (await getSite(locale)).displayName, url: new URL(localePath(locale), site).href },
  headline: title,
  description: summary,
  image: new URL(preview, site).href,
  url: new URL(localePath(locale, `work/${caseSlug(entry)}`), site).href,
  inLanguage: locale,
});
---

<Base
  locale={locale}
  title={`${title} — Jesús Roncal`}
  description={summary}
  image={{ path: preview, alt: interpolate(t('og.caseAlt'), { title, before, after }) }}
  structuredData={structuredData}
  ogType="article"
>
  <Nav locale={locale} />
  <main class="px-page pt-6 pb-24 md:pt-12">
    <article class="mx-auto flex max-w-170 flex-col gap-8" data-case={caseSlug(entry)}>
      <a href={`${localePath(locale)}#work`} class="button-m inline-flex w-fit items-center gap-2 text-muted hover:text-primary">
        <Icon name="arrow-right" size={16} class="rotate-180" />
        {t('case.allWork')}
      </a>

      <header class="flex flex-col gap-4">
        <p class="label-mono text-signal">{caseEyebrow(entry)}</p>
        <h1 class="heading-h2 text-primary">{title}</h1>
        <p class="code-mono text-subtle">{role.title} · {formatPeriod(role.start, role.end, locale)}</p>
      </header>

      <BeforeAfter before={before} after={after} locale={locale} size="full" />

      <div class="body-l flex flex-col gap-5 text-muted [&_h2]:heading-h3 [&_h2]:mt-4 [&_h2]:scroll-mt-4 [&_h2]:text-primary">
        <Content locale={locale} components={{ Mechanism: CaseMechanism }} />
      </div>

      <ul class="flex flex-wrap gap-2" aria-label={t('case.stack')}>
        {stack.map((label) => <StackTag label={label} />)}
      </ul>

      <footer class="mt-8 flex flex-col gap-6 border-t border-border pt-8" data-contact-zone>
        <a href={localePath(locale, `work/${caseSlug(next)}`)} class="group flex flex-col gap-1">
          <span class="label-mono text-subtle">{t('cta.nextCase')}</span>
          <span class="heading-h3 inline-flex items-center gap-2 text-primary">
            {next.data.title}
            <Icon name="arrow-right" size={18} class="motion-safe:transition-transform motion-safe:group-hover:translate-x-1" />
          </span>
        </a>
        <div class="flex flex-wrap gap-3">
          <Button icon="download" href={cvPath(locale)} download data-track="cv_download">{t('cta.downloadCv')}</Button>
          <EmailAction locale={locale} />
        </div>
      </footer>
    </article>
  </main>
  <SiteFooter locale={locale} clearsContactBar />
  <ContactBar locale={locale} />
</Base>
