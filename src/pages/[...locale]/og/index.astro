---
import { Image } from 'astro:assets';
import OgAddress from '../../../components/OgAddress.astro';
import OgCard from '../../../layouts/OgCard.astro';
import portrait from '../../../assets/portrait.jpg';
import profile from '../../../../data/public-profile.json';
import { localeRoutes, type Locale } from '../../../i18n/locales';
import { localiseProfile } from '../../../i18n/profile';
import { useTranslations } from '../../../i18n/translate';
import { getSite } from '../../../lib/site';

export const getStaticPaths = localeRoutes;

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const site = await getSite(locale);
const city = localiseProfile(profile.city, locale).split(',')[0];
---

<OgCard locale={locale} title={site.displayName} aurora="left">
  <div class="flex h-full items-start justify-between">
    <div class="flex h-full w-169 flex-col justify-between">
      <div class="flex flex-col gap-7">
        <p class="flex items-center gap-4">
          <span class="heading-h3 grid size-11 place-items-center rounded-[11px] bg-signal text-on-signal">{site.monogram}</span>
          <span class="heading-h2 text-primary [--fluid-vw:8.34px]">{site.displayName}</span>
        </p>
        <p class="label-mono text-signal">{t('og.role')} · {city}</p>
        <h1 class="text-primary">
          <span class="display block">{site.hero.headlineLead}</span>
          <span class="display-serif block text-signal">{site.hero.headlineAccent}</span>
        </h1>
      </div>
      <OgAddress />
    </div>
    <Image
      src={portrait}
      alt=""
      width={680}
      loading="eager"
      class="portrait-tone h-[502px] w-85 rounded-[28px] border border-border-strong object-cover"
    />
  </div>
</OgCard>
