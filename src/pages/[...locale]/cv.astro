---
import Base from '../../layouts/Base.astro';
import profile from '../../../data/public-profile.json';
import { formatMonth } from '../../i18n/format';
import { localeRoutes, type Locale } from '../../i18n/locales';
import { useTranslations } from '../../i18n/translate';
import { getSite } from '../../lib/site';

export const getStaticPaths = localeRoutes;

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const { cv } = await getSite(locale);
const { name, headline, city, contact, roles, education, skills, languages } = profile;

const highlightsFor = (roleId: string) => cv.highlights.find((entry) => entry.roleId === roleId)?.items ?? [];
const period = (start: string, end: string | null) =>
  `${formatMonth(start, locale)} – ${end ? formatMonth(end, locale) : t('period.now')}`;
const display = (url: string) => decodeURIComponent(url.replace(/^https?:\/\/(www\.)?/, ''));
---

<Base locale={locale} title={`${name} — ${t('cv.title')}`} description={headline} theme="light" noindex>
  <main class="cv">
    <header>
      <h1>{name}</h1>
      <p class="headline">{headline}</p>
      <p class="contact">
        <span>{city}</span>
        <a href={`mailto:${contact.email}`}>{contact.email}</a>
        <a href={contact.linkedin}>{display(contact.linkedin)}</a>
        <a href={contact.github}>{display(contact.github)}</a>
      </p>
    </header>

    <section>
      <h2>{t('cv.summary')}</h2>
      <p>{cv.summary}</p>
    </section>

    <section>
      <h2>{t('cv.experience')}</h2>
      {roles.map((role) => (
        <article>
          <div class="role">
            <h3>
              {role.title} <span class="muted">— {role.organisation}{role.location && `, ${role.location}`}</span>
            </h3>
            <p class="period">{period(role.start, role.end)}</p>
          </div>
          <ul>
            {highlightsFor(role.id).map((item) => <li>{item}</li>)}
          </ul>
        </article>
      ))}
    </section>

    <section>
      <h2>{t('cv.education')}</h2>
      {education.map(({ degree, institution, year }) => (
        <div class="role">
          <h3>
            {degree} <span class="muted">— {institution}</span>
          </h3>
          <p class="period">{year}</p>
        </div>
      ))}
    </section>

    <section>
      <h2>{t('cv.skills')}</h2>
      <dl>
        {skills.map(({ group, items }) => (
          <div>
            <dt>{group}</dt>
            <dd>{items.join(', ')}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section>
      <h2>{t('cv.languages')}</h2>
      <p>{languages.map(({ name, level }) => `${name} — ${level}`).join(' · ')}</p>
    </section>
  </main>
</Base>

<style>
  @page {
    size: A4;
    margin: 12mm 14mm;
  }

  .cv {
    max-width: 182mm;
    margin: 0 auto;
    padding: 12mm 0;
    font-size: 9.5pt;
    line-height: 1.45;
    color: var(--color-primary);
  }

  @media print {
    .cv {
      padding: 0;
    }
  }

  header {
    padding-bottom: 4mm;
    border-bottom: 1px solid var(--color-border-strong);
  }

  h1 {
    font-size: 20pt;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .headline {
    margin-top: 1mm;
    font-size: 11pt;
    color: var(--color-signal);
    font-weight: 500;
  }

  .contact {
    display: flex;
    flex-wrap: wrap;
    gap: 0 4mm;
    margin-top: 2mm;
    font-family: var(--font-mono);
    font-size: 8pt;
    color: var(--color-muted);
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  @media screen {
    .contact a {
      display: inline-block;
      padding-block: 5px;
    }
  }

  section {
    margin-top: 5mm;
  }

  h2 {
    margin-bottom: 2mm;
    font-family: var(--font-mono);
    font-size: 8pt;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-subtle);
  }

  article {
    break-inside: avoid;
    margin-bottom: 3mm;
  }

  .role {
    display: flex;
    justify-content: space-between;
    gap: 4mm;
    align-items: baseline;
  }

  h3 {
    font-size: 10pt;
    font-weight: 600;
  }

  .muted {
    font-weight: 400;
    color: var(--color-muted);
  }

  .period {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 8pt;
    color: var(--color-muted);
  }

  ul {
    margin-top: 1mm;
    padding-left: 4mm;
    list-style: disc;
  }

  li + li {
    margin-top: 0.5mm;
  }

  dl div {
    display: grid;
    grid-template-columns: 38mm 1fr;
    gap: 3mm;
  }

  dt {
    font-weight: 500;
  }

  dd {
    color: var(--color-muted);
  }
</style>
