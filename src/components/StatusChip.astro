---
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<p class="inline-flex w-fit items-center gap-2 rounded-full border border-border bg-raised py-[7px] pr-3.5 pl-3">
  <span class="size-2 rounded-full bg-signal shadow-live" aria-hidden="true"></span>
  <span class="label-mono text-muted">{label}</span>
</p>
