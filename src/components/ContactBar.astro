---
import Button from './Button.astro';
import EmailAction from './EmailAction.astro';
import type { Locale } from '../i18n/locales';
import { useTranslations } from '../i18n/translate';
import { cvPath } from '../lib/cv';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<div
  data-contact-bar
  class="fixed inset-x-4 bottom-4 z-30 flex gap-2.5 rounded-full border border-border-strong bg-surface/85 p-2.5 shadow-float backdrop-blur-lg max-[380px]:gap-2 max-[380px]:p-2 max-[380px]:[&_a]:px-3 max-[380px]:[&_svg]:hidden motion-safe:transition-[translate,opacity] motion-safe:duration-300 data-hidden:pointer-events-none data-hidden:translate-y-[150%] data-hidden:opacity-0 md:hidden"
>
  <Button icon="download" href={cvPath(locale)} download data-track="cv_download" class="flex-1">{t('cta.downloadCv')}</Button>
  <EmailAction locale={locale} class="flex-1" />
</div>

<script>
  const bar = document.querySelector<HTMLElement>('[data-contact-bar]');
  const zones = document.querySelectorAll('[data-contact-zone]');

  if (bar && zones.length) {
    const zonesInView = new Set<Element>();
    // Hidden off-screen, its buttons must not take keyboard focus either; and while one of them
    // has focus the bar stays, so focus is never stranded on an invisible button or dropped.
    const update = (focusInside = bar.contains(document.activeElement)) => {
      const hidden = zonesInView.size > 0 && !focusInside;
      bar.toggleAttribute('data-hidden', hidden);
      bar.inert = hidden;
    };
    const observer = new IntersectionObserver((entries) => {
      for (const { target, isIntersecting } of entries) {
        if (isIntersecting) zonesInView.add(target);
        else zonesInView.delete(target);
      }
      update();
    });
    zones.forEach((zone) => observer.observe(zone));
    // Moving focus scrolls the page, and the observer can report that late (WebKit); measure the
    // zones as focus moves and again on the next frame, so a focused element at the end is never
    // left under the bar.
    const measure = () => {
      for (const zone of zones) {
        const { top, bottom } = zone.getBoundingClientRect();
        if (top < innerHeight && bottom > 0) zonesInView.add(zone);
        else zonesInView.delete(zone);
      }
      update();
    };
    document.addEventListener('focusin', () => {
      measure();
      requestAnimationFrame(measure);
    });
    bar.addEventListener('focusin', () => update(true));
    bar.addEventListener('focusout', (event) => update(bar.contains(event.relatedTarget as Node | null)));
  }
</script>
