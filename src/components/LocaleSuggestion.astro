---
import Button from './Button.astro';
import Icon from './Icon.astro';
import { DEFAULT_LOCALE, localePath, PUBLISHED_LOCALES, stripLocale, type Locale } from '../i18n/locales';
import { interpolate, useTranslations } from '../i18n/translate';

interface Props {
  locale: Locale;
  variant: 'card' | 'pill';
  class?: string;
}

const { locale, variant, class: className } = Astro.props;
const t = useTranslations(locale);
const path = stripLocale(Astro.url.pathname);
const targets = locale === DEFAULT_LOCALE ? PUBLISHED_LOCALES.filter((target) => target !== DEFAULT_LOCALE) : [];
---

{targets.map((target) => {
  const tt = useTranslations(target);
  const href = localePath(target, path);
  return variant === 'card' ? (
    <div
      hidden
      lang={target}
      data-locale-suggestion={target}
      data-published={PUBLISHED_LOCALES.join(' ')}
      class:list={['w-85 rounded-lg border border-border-strong bg-surface py-4.5 pr-4.5 pl-5 shadow-float', className]}
    >
      <div class="flex items-start gap-3">
        <Icon name="globe" size={20} class="mt-0.5 shrink-0 text-glow" />
        <div class="flex-1">
          <p class="body-m text-primary">{tt('suggest.title')}</p>
          <p class="body-s text-muted" lang={locale}>{interpolate(t('suggest.alsoIn'), { language: t(`language.${target}`) })}</p>
        </div>
        <button type="button" data-suggestion-dismiss aria-label={tt('suggest.close')} class="-m-1.5 rounded-full p-1.5 text-muted hover:text-primary">
          <Icon name="close" size={20} />
        </button>
      </div>
      <Button variant="secondary" href={href} hreflang={target} data-locale-link={target} class="mt-3.5">{tt('suggest.action')}</Button>
    </div>
  ) : (
    <div
      hidden
      lang={target}
      data-locale-suggestion={target}
      data-published={PUBLISHED_LOCALES.join(' ')}
      class:list={['flex items-center gap-2.5 rounded-full border border-border-strong bg-surface py-1.5 pr-2 pl-4 shadow-float', className]}
    >
      <Icon name="globe" size={18} class="shrink-0 text-glow" />
      <a href={href} hreflang={target} data-locale-link={target} class="button-m flex-1 py-2 text-primary">{tt('suggest.pill')}</a>
      <button type="button" data-suggestion-dismiss aria-label={tt('suggest.close')} class="rounded-full p-2 text-muted hover:text-primary">
        <Icon name="close" size={18} />
      </button>
    </div>
  );
})}

<script>
  import { revealLocaleSuggestion } from '../scripts/locale';

  revealLocaleSuggestion();
</script>
