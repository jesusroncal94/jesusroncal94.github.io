---
import Icon from './Icon.astro';
import { localePath, type Locale } from '../i18n/locales';
import { useTranslations } from '../i18n/translate';
import { getSite } from '../lib/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const site = await getSite(locale);
const casePath = (slug: string) => localePath(locale, `work/${slug}`);
---

<div class="mt-16 flex flex-col items-center gap-4 max-md:hidden">
  <a
    href="#work"
    data-palette-trigger
    aria-haspopup="dialog"
    class="flex w-full max-w-190 items-center gap-3.5 rounded-full border border-border-strong bg-surface py-2 pr-2 pl-5 shadow-[0_0_48px_color-mix(in_oklab,var(--color-glow)_35%,transparent)] transition-colors hover:border-glow"
  >
    <Icon name="sparkles" size={20} class="text-glow" />
    <span class="body-l flex-1 text-subtle">{site.palette.placeholder}</span>
    <kbd class="code-mono text-subtle">⌘K</kbd>
    <span class="grid size-11 place-items-center rounded-full bg-signal text-on-signal">
      <Icon name="arrow-up" size={18} />
    </span>
  </a>
  <ul class="flex flex-wrap justify-center gap-2">
    {site.palette.questions.map(({ label, case: slug }) => (
      <li>
        <a href={casePath(slug)} class="body-s block rounded-full border border-border px-3.5 py-2 text-muted transition-colors hover:border-border-strong hover:text-primary">
          {label}
        </a>
      </li>
    ))}
  </ul>
  <p class="code-mono text-subtle">{site.palette.hint}</p>
</div>

<dialog
  data-palette
  data-src={`${localePath(locale)}palette.json`}
  aria-label={t('palette.label')}
  class="m-auto mt-[15vh] w-[min(40rem,calc(100%-2rem))] rounded-lg border border-border-strong bg-surface p-0 text-primary shadow-float backdrop:bg-canvas/70 backdrop:backdrop-blur-sm"
>
  <div class="flex items-center gap-3 border-b border-border px-5 py-4 focus-within:border-glow">
    <Icon name="sparkles" size={20} class="text-glow" />
    <input
      data-palette-input
      type="text"
      role="combobox"
      aria-label={t('palette.label')}
      aria-expanded="true"
      aria-controls="palette-results"
      aria-autocomplete="list"
      autocomplete="off"
      spellcheck="false"
      placeholder={site.palette.placeholder}
      class="body-l flex-1 bg-transparent text-primary outline-none placeholder:text-subtle"
    />
    <kbd class="code-mono text-subtle">Esc</kbd>
  </div>
  <ul id="palette-results" role="listbox" aria-label={t('palette.label')} class="max-h-[50vh] overflow-y-auto p-2"></ul>
  <p data-palette-empty hidden class="body-s px-5 pb-6 text-muted">{t('palette.empty')}</p>
  <template data-palette-option>
    <li role="option" aria-selected="false" class="flex cursor-pointer items-center justify-between gap-4 rounded-sm px-3 py-2.5 aria-selected:bg-raised">
      <span class="body-m" data-label></span>
      <span class="label-mono shrink-0 text-subtle" data-group></span>
    </li>
  </template>
</dialog>

<script>
  import { rankEntries, type PaletteEntry } from '../lib/palette';

  const dialog = document.querySelector<HTMLDialogElement>('[data-palette]');
  if (dialog) setUpPalette(dialog);

  function setUpPalette(dialog: HTMLDialogElement) {
    const input = dialog.querySelector<HTMLInputElement>('[data-palette-input]')!;
    const list = dialog.querySelector<HTMLUListElement>('[role="listbox"]')!;
    const empty = dialog.querySelector<HTMLElement>('[data-palette-empty]')!;
    const template = dialog.querySelector<HTMLTemplateElement>('[data-palette-option]')!;
    let entries: Promise<PaletteEntry[]> | undefined;
    let visible: PaletteEntry[] = [];
    let active = 0;

    const load = () => (entries ??= fetch(dialog.dataset.src!).then((response) => response.json()));

    const optionFor = (entry: PaletteEntry) => {
      const option = template.content.firstElementChild!.cloneNode(true) as HTMLLIElement;
      option.id = `palette-${entry.id}`;
      option.querySelector('[data-label]')!.textContent = entry.label;
      option.querySelector('[data-group]')!.textContent = entry.groupLabel ?? '';
      option.addEventListener('click', () => follow(entry));
      return option;
    };

    const setActive = (index: number) => {
      active = Math.max(0, Math.min(index, visible.length - 1));
      const options = [...list.children];
      options.forEach((option, position) => option.setAttribute('aria-selected', String(position === active)));
      const current = options[active];
      if (!current) return input.removeAttribute('aria-activedescendant');
      current.scrollIntoView({ block: 'nearest' });
      input.setAttribute('aria-activedescendant', current.id);
    };

    const render = async () => {
      visible = rankEntries(input.value, await load());
      list.replaceChildren(...visible.map(optionFor));
      empty.hidden = visible.length > 0;
      setActive(0);
    };

    const follow = (entry: PaletteEntry | undefined) => {
      if (!entry) return;
      dialog.close();
      if (entry.external) window.open(entry.href, '_blank', 'noopener');
      else window.location.href = entry.href;
    };

    const open = () => {
      input.value = '';
      dialog.showModal();
      input.focus();
      render();
    };

    input.addEventListener('input', render);
    input.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowDown') setActive(active + 1);
      else if (event.key === 'ArrowUp') setActive(active - 1);
      else if (event.key === 'Enter') follow(visible[active]);
      else return;
      event.preventDefault();
    });
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
    document.querySelectorAll('[data-palette-trigger]').forEach((trigger) => {
      trigger.setAttribute('role', 'button');
      trigger.addEventListener('pointerenter', load, { once: true });
      trigger.addEventListener('focus', load, { once: true });
      trigger.addEventListener('click', (event) => {
        event.preventDefault();
        open();
      });
    });
    document.addEventListener('keydown', (event) => {
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
        event.preventDefault();
        if (dialog.open) dialog.close();
        else open();
      }
    });
  }
</script>
