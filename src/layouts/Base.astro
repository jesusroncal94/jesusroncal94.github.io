---
import '../styles/global.css';
import geistFont from '../assets/fonts/geist.woff2?url';
import serifItalicFont from '../assets/fonts/instrument-serif-italic.woff2?url';
import { getAbsoluteLocaleUrl } from 'astro:i18n';
import { DEFAULT_LOCALE, PUBLISHED_LOCALES, stripLocale, type Locale } from '../i18n/locales';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
  theme?: 'dark' | 'light';
}

const { locale, title, description, image, noindex = false, theme = 'dark' } = Astro.props;
const path = stripLocale(Astro.url.pathname);
const canonical = getAbsoluteLocaleUrl(locale, path);
const alternates = PUBLISHED_LOCALES.map((alternate) => ({
  hreflang: alternate,
  href: getAbsoluteLocaleUrl(alternate, path),
}));
const imageUrl = image ? new URL(image, Astro.site).href : undefined;
---

<!doctype html>
<html lang={locale} data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    {alternates.map(({ hreflang, href }) => <link rel="alternate" hreflang={hreflang} href={href} />)}
    <link rel="alternate" hreflang="x-default" href={getAbsoluteLocaleUrl(DEFAULT_LOCALE, path)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={geistFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={serifItalicFont} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Jesús Roncal" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale} />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    <meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
  </head>
  <body>
    <slot />
  </body>
</html>
