---
import '../styles/global.css';
import type { Locale } from '../i18n/locales';
import { PREVIEW_SIZE } from '../lib/preview';

interface Props {
  locale: Locale;
  title: string;
  aurora: 'left' | 'right';
}

const { locale, title, aurora } = Astro.props;
---

<!doctype html>
<html lang={locale} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content={`width=${PREVIEW_SIZE.width}`} />
    <meta name="robots" content="noindex" />
    <title>{title}</title>
  </head>
  <body class="m-0">
    <div
      data-og-card
      class="relative isolate h-[630px] w-[1200px] overflow-hidden bg-canvas p-16 [--fluid-vw:14.4px]"
    >
      <div
        class:list={[
          'pointer-events-none absolute -z-10 h-130 w-225 bg-[radial-gradient(closest-side,color-mix(in_oklab,var(--color-glow)_45%,transparent),transparent)]',
          aurora === 'left' ? 'top-90 -left-55' : 'top-95 left-140',
        ]}
        aria-hidden="true"
      >
      </div>
      <div data-og-content class="h-full">
        <slot />
      </div>
    </div>
  </body>
</html>
