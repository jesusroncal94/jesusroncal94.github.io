{
  "font": {
    "family": "Geist",
    "fallback": ["Segoe UI", "Roboto", "Helvetica", "Arial", "sans-serif"],
    "mono": "Geist Mono",
    "mono-fallback": ["ui-monospace", "Consolas", "monospace"]
  },
  "typography": {
    "title": { "size": 22, "weight": 600 },
    "section": { "size": 15, "weight": 600 },
    "node-title": { "size": 13, "weight": 600 },
    "body": { "size": 12, "weight": 400 },
    "note": { "size": 11, "weight": 400, "mono": true }
  },
  "neutral": {
    "canvas": "#faf8f5", "surface": "#ffffff", "raised": "#f2efea",
    "border": "#e7e2da", "border-strong": "#d6cfc4",
    "primary": "#1c1917", "muted": "#57534e", "subtle": "#6b655e"
  },
  "role": {
    "human": { "fill": "#ffffff", "stroke": "#3f6212", "stroke-width": 2 },
    "agent": { "fill": "#ede9fe", "stroke": "#4f46e5" },
    "sensor": { "fill": "#f2efea", "stroke": "#57534e" },
    "artefact": { "fill": "#ffffff", "stroke": "#d6cfc4" },
    "production": { "fill": "#1c1917", "stroke": "#1c1917" },
    "private": { "fill": "#ffffff", "stroke": "#b42318", "dashed": true }
  },
  "signal": { "alert": "#b42318", "feedback": "#4f46e5" }
}
